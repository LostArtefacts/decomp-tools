#!/usr/bin/env python3
# Enforces 50/72 commit messages: a subject of at most 50 characters, a
# blank second line, and body lines of at most 72 characters. A body line
# without spaces (a URL, a long symbol) may run over. The subject is a
# plain sentence, without a `type:` or `type(scope):` prefix, and the
# message has no trailers (Co-Authored-By, Signed-off-by, ...). Enable
# with `just hooks`.
#
# Merges and the commits git subtree writes keep the messages git makes
# for them ("Merge commit '<sha>' as 'tools'" is over 50 characters), so
# they skip the length and prefix rules; the trailer rule still applies.
import os, re, subprocess, sys

SUBTREE = re.compile(r"(Merge commit '[0-9a-f]+'( as '[^']+')?|Add '[^']+/' from commit '[0-9a-f]+'"
                     r"|Squashed '[^']+' (content from commit|changes from [0-9a-f]+\.\.) ?[0-9a-f]+)$")


def merging():
    git_dir = subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True, text=True).stdout.strip()
    return bool(git_dir) and os.path.exists(os.path.join(git_dir, "MERGE_HEAD"))

lines = []
for line in open(sys.argv[1], encoding="utf-8").read().splitlines():
    if line.startswith("# ------------------------ >8 ------------------------"):
        break
    if not line.startswith("#"):
        lines.append(line.rstrip())
while lines and not lines[-1]:
    lines.pop()
while lines and not lines[0]:
    lines.pop(0)

errors = []
git_made = bool(lines) and (merging() or SUBTREE.match(lines[0]))
if lines and len(lines[0]) > 50 and not git_made:
    errors.append(f"subject is {len(lines[0])} characters, over 50: {lines[0]}")
if lines and re.match(r"[\w-]+(\([^)]*\))?!?: ", lines[0]) and not git_made:
    errors.append(f"subject has a type prefix: {lines[0]}")
if len(lines) > 1 and lines[1] and not git_made:
    errors.append("the second line must be blank")
for n, line in enumerate(lines[2:], 3):
    if len(line) > 72 and " " in line and not git_made:
        errors.append(f"line {n} is {len(line)} characters, over 72: {line}")
    if re.match(r"[\w-]+-by: ", line, re.IGNORECASE):
        errors.append(f"line {n} is a trailer: {line}")

if errors:
    for e in errors:
        print(f"commit-msg: {e}", file=sys.stderr)
    sys.exit(1)
