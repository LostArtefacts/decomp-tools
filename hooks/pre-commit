#!/bin/sh
# With hooks.compare or hooks.one_function in project.toml, checks the
# commit rules (tools/gate.py). With hooks.progress, redraws
# docs/progress.svg from the working tree and adds it to the commit, so
# every commit carries its own progress. Enable with `just hooks`. A
# failed build stops the commit.
set -e
cd "$(git rev-parse --show-toplevel)"
[ -f project.toml ] || exit 0
python3 tools/gate.py pre-commit
[ "$(python3 tools/project.py get hooks.progress)" = True ] || exit 0
out=$(just progress 2>&1) || { echo "$out"; echo "pre-commit: just progress failed"; exit 1; }
echo "$out" | tail -1
git add docs/progress.svg
